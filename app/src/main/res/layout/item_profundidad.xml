<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginLeft="12dp"
    android:layout_marginRight="12dp"
    android:layout_marginTop="6dp"
    android:layout_marginBottom="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutlineVariant">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <TextView
            android:id="@+id/lblProfundidadTitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Profundidad:"
            android:textSize="12sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <LinearLayout
            android:id="@+id/contenedor_profundidades"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toBottomOf="@id/lblProfundidadTitulo"
            app:layout_constraintStart_toStartOf="parent">
            <LinearLayout
                android:id="@+id/contenedor_profundiad_inicial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/label_profundidadesInicial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Prof. Inicial: "
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface" />
                <TextView
                    android:id="@+id/item_profundidadesInicial"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="0.00 mts"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface" />
            </LinearLayout>

            <!--        <TextView-->
            <!--            android:id="@+id/lblSeparador"-->
            <!--            android:layout_width="wrap_content"-->
            <!--            android:layout_height="wrap_content"-->
            <!--            android:layout_marginHorizontal="6dp"-->
            <!--            android:text="→"-->
            <!--            android:textSize="14sp"-->
            <!--            android:textColor="?attr/colorOnSurfaceVariant"-->
            <!--            app:layout_constraintBaseline_toBaselineOf="@id/item_profundidadesInicial"-->
            <!--            app:layout_constraintStart_toEndOf="@id/item_profundidadesInicial" />-->

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                >
                <TextView
                    android:id="@+id/label_profundidadesFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Prof. Final:   "
                    android:textSize="14sp"
                    android:textColor="?attr/colorOnSurface"
                    />
                <TextView
                    android:id="@+id/item_profundidadesFinal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2.50 mts"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="?attr/colorOnSurface"
                    />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:id="@+id/sucs"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_badge_sucs"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            tools:text="SUCS: CL"
            android:textSize="12sp"
            android:textStyle="bold"
            android:layout_marginBottom="25dp"
            android:textColor="?attr/colorPrimary"
            app:layout_constraintBottom_toBottomOf="@id/contenedor_profundidades"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/lblProfundidadTitulo" />

        <TextView
            android:id="@+id/descripcion"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            tools:text="Arcilla de alta plasticidad, color marrón oscuro con trazas de arena fina."
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/contenedor_profundidades" />

        <LinearLayout
            android:id="@+id/containerBotones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/descripcion">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonVerGolpes"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Golpes"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/botonEditarProfundidad"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="4dp"
                android:text="Editar"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/boton_eliminar_profundidad"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/bordo"
                android:textColor="@color/white"
                android:text="Borrar"
                android:textSize="13sp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>